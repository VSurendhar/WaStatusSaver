<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Cloud backup is already disabled via android:allowBackup="false" in the manifest.
   On Android 12+, allowBackup="false" does NOT stop device-to-device transfer, so
   exclusions for that are set here.
-->
<data-extraction-rules>
    <device-transfer>
        <!-- Mixpanel stores its anonymous device ID in SharedPreferences. Excluding them
             makes a new phone get a fresh device ID instead of copying the old one.
             The app's own settings use DataStore (files domain), so they still transfer. -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
